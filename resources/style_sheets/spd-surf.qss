/*-------------------- Green Stylesheet for Sermon Prep Database --------------------
Note: Qt default background for widgets is #f0f0f0 or 240, 240, 240

General Theme Colors:
    accent color: #208080
    background color: #e0ffff
    font color: #000000
    text background: #ffffff
*/

/*-------------------- help_widget, about_widget --------------------*/
QWidget#help_widget, QWidget#about_widget {
    background-color: #e0ffff;
}

/*-------------------- tab_container --------------------*/
QWidget#tab_container {
    background-color: #e0ffff;
    border: none;
    border-top: 2px solid #ffffff;
}

/*-------------------- text_box --------------------*/
QWidget#text_box {
    background-color: #e0ffff;
    border: 1px solid #208080;
}

/*-------------------- text_box_edit --------------------*/
QWidget#text_box_text_edit {
    background-color: #e0ffff;
}

/*-------------------- title_label --------------------*/
QLabel#title_label {
    color: #208080;
    margin-bottom: 20px;
}

/*-------------------- QComboBox --------------------*/
QComboBox {
    background: #ffffff;
    color: #000000;
    border: 1px solid #000000;
}
QComboBox QAbstractItemView {
    background: #ffffff;
    color: #000000;
}
QComboBox QAbstractItemView::item {
    background: #ffffff;
    color: #000000;
    border: none;
}
QComboBox QAbstractItemView::item:hover {
    background: #e0ffff;
    color: #000000;
    border: none;
}
QComboBox QAbstractItemView::item:selected {
    background: #e0ffff;
    color: #000000;
    border: none;
}

/*-------------------- QDialog --------------------*/
QDialog {
    background-color: #e0ffff;
}
QDialog QLabel {
    color: #000000;
}

/*-------------------- QLabel --------------------*/
QLabel {
    background: transparent;
    color: #000000
}

/*-------------------- QLineEdit --------------------*/
QLineEdit, QDateEdit, QComboBox {
    background: #ffffff;
    color: #000000;
    border: 1px solid #208080;
    min-height: 24px;
}
QLineEdit:focus, QDateEdit:focus {
    border-bottom: 3px solid #208080;
}

/*-------------------- QMainWindow --------------------*/
QMainWindow {
    background-color: #e0ffff;
}

/*-------------------- QMenuBar --------------------*/
QMenuBar {
    background: #e0ffff;
    color: #000000;
    border-bottom: 2px solid #ffffff;
    padding-bottom: 3px;
    margin-bottom: -1px;
}
QMenuBar::item {
    background: #e0ffff;
    color: #000000;
}
QMenuBar::item:selected {
    background: #ffffff;
}
QMenuBar::item:pressed {
    background: #e0ffff;
}

/*-------------------- QMenu --------------------*/
QMenu {
    background: #e0ffff;
    color: #000000;
    border: 1px solid #d0d0d0;
}
QMenu::item {
    background: #e0ffff;
    color: #000000;
    padding: 10px 15px;
}
QMenu::item:selected {
    background: #ffffff;
}
QMenu::item:pressed {
    background: #e0ffff;
}

/*-------------------- QMessageBox --------------------*/
QMessageBox {
    background-color: #e0ffff;
}
QMessageBox QLabel {
    color: #000000;
}

/*-------------------- QPushButton --------------------*/
QPushButton {
	background: #e0ffff;
	color: #000000;
	padding-left: 10px;
	padding-right: 10px;
	padding-top: 5px;
	padding-bottom: 5px;
	border: 1px solid lightGrey;
	border-style: outset;
}
QPushButton:hover {
	background: #208080;
	color: #ffffff;
}
QPushButton:pressed {
	background: #aaaaaa;
}
QPushButton:disabled {
    background: #a0a0a0;
    color: grey;
}
QPushButton:checked {
    border-bottom: 2px solid #208080;
    padding-bottom: 3px;
}
QPushButton:unchecked {
    border-bottom: none;
}

/*-------------------- QScrollBar --------------------*/
QScrollBar {
	background : #e0ffff;
	color: #000000;
}

/*-------------------- QTabBar --------------------*/
QTabBar::tab {
    background-color: #208080;
    color: #ffffff;
    font-weight: normal;
    min-width: 120px;
    min-height: 32px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-right: 2px solid #e0ffff;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}
QTabBar::tab:icon {
    padding-left: 10px;
}
QTabBar::tab:label {
    padding-right: 10px;
}
QTabBar::tab:selected {
    color: #208080;
    background-color: #e0ffff;
    font-weight: bold;
    border-top: 3px solid #208080;
    padding-top: 2px;
}
QTabBar::tab:last {
    border-right: none;
}

/*-------------------- QTabWidget --------------------*/
QTabWidget {
    background-color: #ffffff;
}
QTabWidget::pane {
    padding: 20px;
    background-color: #e0ffff;
    border: none;
}

/*-------------------- QTextEdit --------------------*/
QTextEdit {
    background: #ffffff;
    color: #000000;
    border: 1px solid #208080;
}
QTextEdit:focus {
    border-bottom: 3px solid #208080;
}